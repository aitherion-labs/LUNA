{
    "family": "agentic-api",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
      "FARGATE"
    ],
    "executionRoleArn": "arn:aws:iam::487317040496:role/agentic-api-20260210154730165400000004",
    "taskRoleArn": "arn:aws:iam::487317040496:role/agentic-api-20260210154730164900000003",
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
      {
        "name": "agentic-api",
        "image": "487317040496.dkr.ecr.us-east-1.amazonaws.com/agentic-api:latest",
        "essential": true,
        "portMappings": [
          {
            "name": "agentic-api-http",
            "containerPort": 8000,
            "protocol": "tcp"
          }
        ],
        "secrets": [
            {
                "name": "MODEL_ID",
                "valueFrom": "arn:aws:ssm:us-east-1:487317040496:parameter/agentic-api/MODEL_ID"
            },
            {
                "name": "API_TOKEN",
                "valueFrom": "arn:aws:ssm:us-east-1:487317040496:parameter/agentic-api/API_TOKEN"
            },
            {
                "name": "S3_BUCKET_SESSIONS",
                "valueFrom": "arn:aws:ssm:us-east-1:487317040496:parameter/agentic-api/S3_BUCKET_SESSIONS"
            },
            {
                "name": "ID_KBS",
                "valueFrom": "arn:aws:ssm:us-east-1:487317040496:parameter/agentic-api/ID_KBS"
            }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/aws/ecs/agentic-api/agentic-api",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "ecs"
          }
        },
        "environment": [
          {
            "name": "PREFIX_SESSIONS",
            "value": "orchestrator/"
          }
        ]
      }
    ]
}